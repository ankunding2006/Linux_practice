#include <atomic>
#include <chrono>
#include <iostream>
#include <thread>
#include <csignal>
#include <iostream>
#include <unistd.h>
#include "ThreadSafeQueue.hpp"

std::atomic<bool> running{false};

ThreadSafeQueue<int> Q1;

void handler(int sig)
{
  std::cout << std::endl
            << "Received signal: " << sig << std::endl;
  running = 0;
  std::cout << "running==0" << std::endl;
}

void _task1()
{
  u_int16_t i = 0;
  while (running)
  {
    std::this_thread::sleep_for(std::chrono::milliseconds(500));
    Q1.push(i);
    std::cout << "queue: " << i << std::endl;
    i++;
  }
}

void _task2()
{
  while (running)
  {
    std::cout << Q1.pop() << std::endl;
  }
}

void _task3()
{
  while(running)
{
  std::this_thread::sleep_for(std::chrono::milliseconds(1400));

std::cout＜＜"运行中"＜＜std::endl;
}
}

int main(void)
{
  std::cout << "programe begin" << std::endl;
  struct sigaction action;
  action.sa_handler = handler;
  sigemptyset(&action.sa_mask);
  sigaddset(&action.sa_mask, SIGINT);
  action.sa_flags = 0;
  if (sigaction(SIGINT, &action, nullptr))
  {
    perror("signal");
    return 1;
  }
  running = true;
  std::thread t1(_task1);
  std::thread t2(_task2);
  std::thread t3(_task3);

  t1.join();
  t2.join();
  t3.join();
}